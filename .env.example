DATABASE_URL=sqlite:///data/db/stock_analyzer.db
HTTP_PROXY=
HTTPS_PROXY=
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DATA_CACHE_DIR=data/raw
DATA_CACHE_TTL_HOURS=12

# 数据更新并发线程数
UPDATE_MAX_WORKERS=8
INDUSTRY_MAP_MAX_WORKERS=8

# 行情数据域名直连：开了 Clash/VPN 全局代理时，会把国内行情请求也代理到境外导致连接被重置。
# 默认开启(=1)，自动把这些域名加入 NO_PROXY 走直连；如需关闭设为 0。
AKSHARE_BYPASS_PROXY=1

# DeepSeek（AI 分析）。在 https://platform.deepseek.com 申请 Key 并充值后填入。
# 模型示例：deepseek-v4-pro / deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_TEMPERATURE=0.3
# deepseek-chat 为混合推理模型，token 预算要够大（含推理），否则 content 可能为空
DEEPSEEK_MAX_TOKENS=3000
